# =============================================================================
# JGH Clone Bot — modèle de configuration
#
# Copier ce fichier en .env et renseigner les valeurs réelles.
# NE JAMAIS committer le .env (il est dans .gitignore).
# =============================================================================

# --- Telegram ---
# Token du bot (BotFather). DISTINCT de celui de JGH Alert Bot.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here
# IDs Telegram autorisés à utiliser le bot (lecture), séparés par des virgules
ALLOWED_TELEGRAM_IDS=111111111,222222222
# IDs Telegram admins (peuvent déclencher /provision), séparés par des virgules
ADMIN_TELEGRAM_IDS=111111111

# --- Coolify (API v1) ---
COOLIFY_BASE_URL=http://51.255.204.248:8000
# Jeton API scopé read + write + deploy
COOLIFY_TOKEN=1|your-coolify-api-token-here
COOLIFY_SERVER_UUID=xxxxxxxxxxxxxxxxxxxxxxxx
COOLIFY_PROJECT_UUID=xxxxxxxxxxxxxxxxxxxxxxxx
COOLIFY_ENVIRONMENT_NAME=production
COOLIFY_ENVIRONMENT_UUID=xxxxxxxxxxxxxxxxxxxxxxxx
COOLIFY_TIMEOUT=30

# --- Base de données locale (DuckDB) ---
DB_PATH=clone.duckdb

# --- Domaine ---
# Suffixe des sous-domaines déployés.
# Test : <ip>.sslip.io (pas de DNS requis). Prod : s1.yessalerp.com
DOMAIN_SUFFIX=51.255.204.248.sslip.io

# --- Catalogue de packs ---
# Pack déployé par défaut si non précisé dans /provision
DEFAULT_PACK=pos

# Pack POS : repo du docker-compose de prod + deploy key Coolify
PACK_POS_REPOSITORY=git@github.com:jaxaayannuaire/jgh-pack-pos.git
PACK_POS_BRANCH=main
PACK_POS_DEPLOY_KEY_UUID=your-coolify-deploy-key-uuid

# --- (à venir) autres packs ---
# PACK_TAMBALI_DEPLOY_KEY_UUID=
# PACK_ASSO_DEPLOY_KEY_UUID=
# PACK_PRO_DEPLOY_KEY_UUID=
# PACK_IMMO_DEPLOY_KEY_UUID=
